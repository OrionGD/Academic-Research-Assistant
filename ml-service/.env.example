# ARAS ML Service Environment Variables 

# AI / Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=ARAS
DATABASE_NAME=aras_db

# Security
ML_SERVICE_API_KEY=your_secure_ml_service_key_here

# Embeddings & Search
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
VECTOR_INDEX_NAME=vector_index
VECTOR_NUM_CANDIDATES=200
CHAT_MODEL=gemini-1.5-flash
