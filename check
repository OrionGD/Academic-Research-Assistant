#!/bin/bash

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
SERVICE_NAME="vector-db-integrations"
HEALTH_CHECK_INTERVAL=5
MAX_RETRIES=12
TIMEOUT=10

# Services to check
declare -A SERVICES=(
    ["app"]="http://localhost:8000/health"
    ["chromadb"]="http://localhost:8001/api/v1/heartbeat"
    ["mongodb"]="mongodb://localhost:27017"
    ["qdrant"]="http://localhost:6333/healthz"
    ["redis"]="redis://localhost:6379"
    ["prometheus"]="http://localhost:9090/-/healthy"
    ["grafana"]="http://localhost:3000/api/health"
    ["nginx"]="http://localhost:80/health"
)

# Function to print colored output
print_status() {
    local service=$1
    local status=$2
    local message=$3
    
    case $status in
        "OK")
            echo -e "${GREEN}✓${NC} $service: $message"
            ;;
        "WARNING")
            echo -e "${YELLOW}⚠${NC} $service: $message"
            ;;
        "ERROR")
            echo -e "${RED}✗${NC} $service: $message"
            ;;
        "INFO")
            echo -e "${BLUE}ℹ${NC} $service: $message"
            ;;
    esac
}

# Function to check HTTP endpoint
check_http() {
    local url=$1
    local name=$2
    
    if command -v curl &> /dev/null; then
        response=$(curl -s -o /dev/null -w "%{http_code}" --max-time $TIMEOUT "$url" 2>/dev/null)
        if [ "$response" = "200" ] || [ "$response" = "204" ]; then
            print_status "$name" "OK" "HTTP $response"
            return 0
        else
            print_status "$name" "ERROR" "HTTP $response"
            return 1
        fi
    elif command -v wget &> /dev/null; then
        if wget --spider --timeout=$TIMEOUT -q "$url" 2>/dev/null; then
            print_status "$name" "OK" "Accessible"
            return 0
        else
            print_status "$name" "ERROR" "Not accessible"
            return 1
        fi
    else
        print_status "$name" "WARNING" "curl/wget not available"
        return 2
    fi
}

# Function to check MongoDB
check_mongodb() {
    local uri=$1
    
    if command -v mongosh &> /dev/null; then
        if mongosh "$uri" --eval "db.adminCommand('ping')" --quiet &>/dev/null; then
            print_status "mongodb" "OK" "Connected"
            return 0
        else
            print_status "mongodb" "ERROR" "Cannot connect"
            return 1
        fi
    elif command -v mongo &> /dev/null; then
        if mongo "$uri" --eval "db.adminCommand('ping')" --quiet &>/dev/null; then
            print_status "mongodb" "OK" "Connected"
            return 0
        else
            print_status "mongodb" "ERROR" "Cannot connect"
            return 1
        fi
    else
        print_status "mongodb" "WARNING" "mongo/mongosh not available"
        return 2
    fi
}

# Function to check Redis
check_redis() {
    local uri=$1
    
    if command -v redis-cli &> /dev/null; then
        if redis-cli -u "$uri" ping 2>/dev/null | grep -q "PONG"; then
            print_status "redis" "OK" "Connected"
            return 0
        else
            print_status "redis" "ERROR" "Cannot connect"
            return 1
        fi
    else
        print_status "redis" "WARNING" "redis-cli not available"
        return 2
    fi
}

# Function to check Docker containers
check_docker_containers() {
    if ! command -v docker &> /dev/null; then
        print_status "docker" "WARNING" "Docker not available"
        return 2
    fi
    
    local containers=$(docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null)
    if [ $? -eq 0 ]; then
        echo -e "\n${BLUE}Docker Containers:${NC}"
        echo "$containers"
    fi
}

# Function to check system resources
check_system_resources() {
    echo -e "\n${BLUE}System Resources:${NC}"
    
    # CPU load
    if command -v uptime &> /dev/null; then
        load=$(uptime | awk -F'load average:' '{print $2}')
        echo "  CPU Load: $load"
    fi
    
    # Memory usage
    if command -v free &> /dev/null; then
        memory=$(free -h | grep "^Mem:" | awk '{print $3 "/" $2}')
        echo "  Memory: $memory"
    fi
    
    # Disk usage
    if command -v df &> /dev/null; then
        disk=$(df -h . | tail -1 | awk '{print $5 " used"}')
        echo "  Disk: $disk"
    fi
}

# Function to check Python environment
check_python_env() {
    echo -e "\n${BLUE}Python Environment:${NC}"
    
    if command -v python3 &> /dev/null; then
        version=$(python3 --version 2>&1)
        echo "  $version"
        
        # Check virtual environment
        if [ -n "$VIRTUAL_ENV" ]; then
            echo "  Virtual Env: $VIRTUAL_ENV"
        else
            echo "  Virtual Env: Not activated"
        fi
        
        # Check installed packages
        if command -v pip3 &> /dev/null; then
            packages=$(pip3 list --format=freeze | wc -l)
            echo "  Installed packages: $packages"
        fi
    else
        print_status "python" "ERROR" "Python3 not found"
    fi
}

# Main health check function
run_health_checks() {
    echo -e "${GREEN}=== Health Check for $SERVICE_NAME ===${NC}"
    echo "Started at: $(date)"
    echo ""
    
    local failed=0
    local warnings=0
    
    # Check all services
    for service in "${!SERVICES[@]}"; do
        url="${SERVICES[$service]}"
        
        case $service in
            "mongodb")
                check_mongodb "$url"
                result=$?
                ;;
            "redis")
                check_redis "$url"
                result=$?
                ;;
            *)
                check_http "$url" "$service"
                result=$?
                ;;
        esac
        
        case $result in
            1) ((failed++)) ;;
            2) ((warnings++)) ;;
        esac
    done
    
    # Check Docker containers
    check_docker_containers
    
    # Check system resources
    check_system_resources
    
    # Check Python environment
    check_python_env
    
    # Summary
    echo -e "\n${BLUE}=== Summary ===${NC}"
    total_services=${#SERVICES[@]}
    passed=$((total_services - failed - warnings))
    
    echo -e "${GREEN}✓ Passed: $passed${NC}"
    echo -e "${YELLOW}⚠ Warnings: $warnings${NC}"
    echo -e "${RED}✗ Failed: $failed${NC}"
    
    # Wait for services if any are failing
    if [ $failed -gt 0 ] && [ $1 = "--wait" ]; then
        echo -e "\n${YELLOW}Waiting for services to become healthy...${NC}"
        wait_for_services
    fi
    
    return $failed
}

# Function to wait for services
wait_for_services() {
    local retries=0
    
    while [ $retries -lt $MAX_RETRIES ]; do
        local still_failing=0
        
        for service in "${!SERVICES[@]}"; do
            url="${SERVICES[$service]}"
            
            case $service in
                "mongodb")
                    check_mongodb "$url" > /dev/null 2>&1
                    ;;
                "redis")
                    check_redis "$url" > /dev/null 2>&1
                    ;;
                *)
                    check_http "$url" "$service" > /dev/null 2>&1
                    ;;
            esac
            
            if [ $? -eq 1 ]; then
                still_failing=$((still_failing + 1))
            fi
        done
        
        if [ $still_failing -eq 0 ]; then
            echo -e "${GREEN}All services are healthy!${NC}"
            return 0
        fi
        
        echo "Waiting for $still_failing services... ($((retries + 1))/$MAX_RETRIES)"
        sleep $HEALTH_CHECK_INTERVAL
        retries=$((retries + 1))
    done
    
    echo -e "${RED}Timeout waiting for services${NC}"
    return 1
}

# Parse command line arguments
case "$1" in
    --wait|-w)
        run_health_checks "--wait"
        ;;
    --continuous|-c)
        while true; do
            clear
            run_health_checks
            echo -e "\n${YELLOW}Press Ctrl+C to exit${NC}"
            sleep $HEALTH_CHECK_INTERVAL
        done
        ;;
    --help|-h)
        echo "Usage: $0 [OPTION]"
        echo "Health check script for $SERVICE_NAME"
        echo ""
        echo "Options:"
        echo "  --wait, -w       Wait for services to become healthy"
        echo "  --continuous, -c Run in continuous mode (refresh every $HEALTH_CHECK_INTERVAL seconds)"
        echo "  --help, -h       Show this help message"
        echo ""
        echo "Without options, runs a single health check and exits."
        ;;
    *)
        run_health_checks
        exit $?
        ;;
esac