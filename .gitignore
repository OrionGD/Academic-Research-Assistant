# ScholarAI Enterprise System .gitignore
# Cohesive, multi-environment ignore file designed for modern Node.js, Vite, Python, and Database operations.

# ==========================================
# 1. Dependencies & Package Managers
# ==========================================
node_modules/
backend/venv/
backend/ScholarAI/
frontend/node_modules/
.venv/
venv/
env/
__pycache__/
**/.pytest_cache/
*.pyc
*.py[cod]
*$py.class
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.pnp.*

# ==========================================
# 2. Environment Variables & Secrets
# ==========================================
.env
.env.*
!.env.example
.env.local
.env.*.local
backend/.env
frontend/.env
scripts/.env
serviceAccountKey.json
credentials.json
secrets.toml
*.pem
*.key
*.pfx
*.p12
.emv

# ==========================================
# 3. Logs & Debugging
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock

# ==========================================
# 4. Databases, Vectors & Storage
# ==========================================
*.db
*.sqlite
*.sqlite3
research.db
frontend/research.db
chroma_storage/
backend/chroma_storage/
chroma_db/
backend/chroma_db/
data/
backend/data/
backend/scratch/
dump.rdb
.redis/

# ==========================================
# 5. Uploads, Scratch & Sandbox
# ==========================================
uploads/
frontend/uploads/
backend/uploads/

# ==========================================
# 6. Build, Distribution & Caching
# ==========================================
dist/
build/
out/
.next/
.cache/
.vite/
.turbo/
.parcel-cache/
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_ts/
*.tsbuildinfo

# ==========================================
# 7. IDE, Editors & System Files
# ==========================================
.vscode/
.idea/
.history/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
*.suo
*.user
*.sln
*.userosscache
*.sln.docstates
.project
.settings/
.classpath
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
Icon

# ==========================================
# 8. Testing & Coverage
# ==========================================
.coverage
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.nyc_output/
cypress/videos/
cypress/screenshots/
.ipynb_checkpoints/