rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024 && // 5MB max
             request.resource.contentType.matches('image/.*');
    }
    
    function isValidDocument() {
      return request.resource.size < 50 * 1024 * 1024 && // 50MB max
             request.resource.contentType.matches('application/pdf|application/msword|application/vnd.openxmlformats-officedocument.*|text/plain|text/markdown');
    }

    // User avatars
    match /users/{userId}/avatar/{fileName} {
      allow read: if true; // Public read
      allow write: if isOwner(userId) && isValidImage();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Document uploads
    match /documents/{userId}/{documentId}/{fileName} {
      allow read: if isAuthenticated() && 
        (isOwner(userId) || isAdmin() || 
         firestore.get(/databases/(default)/documents/documents/$(documentId)).data.visibility == 'public' ||
         firestore.get(/databases/(default)/documents/documents/$(documentId)).data.sharedWith.hasAny([request.auth.uid]));
      
      allow write: if isOwner(userId) && isValidDocument();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Temporary uploads (for processing)
    match /temp/{userId}/{fileName} {
      allow read: if false; // No direct read access
      allow write: if isAuthenticated() && 
        request.resource.size < 100 * 1024 * 1024 && // 100MB max
        request.resource.timeCreated > request.time - duration.time(24, 0, 0, 0); // Auto-expire after 24 hours
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Public assets
    match /public/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // System backups (admin only)
    match /backups/{backupId}/{fileName} {
      allow read, write: if isAdmin();
    }

    // Chat attachments
    match /chat/{conversationId}/{messageId}/{fileName} {
      allow read: if isAuthenticated() && 
        firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
      
      allow write: if isAuthenticated() && 
        request.resource.size < 10 * 1024 * 1024 && // 10MB max
        request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Thumbnails cache
    match /thumbnails/{documentId}/{size}.jpg {
      allow read: if true; // Public read
      allow write: if false; // Generated by system functions
    }

    // AI-generated content cache
    match /cache/ai/{cacheId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if false; // System use only
    }
  }
}
