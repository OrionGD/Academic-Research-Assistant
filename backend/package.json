{
  "name": "aras-backend",
  "version": "1.0.0",
  "description": "AI Academic Research Assistant Backend",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "start:workers": "node dist/workers/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:workers": "ts-node-dev --respawn --transpile-only src/workers/index.ts",
    "build": "tsc",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/storage": "^5.18.3",
    "@google/genai": "^1.45.0",
    "@google/generative-ai": "^0.21.0",
    "@langchain/textsplitters": "^1.0.1",
    "@types/uuid": "^10.0.0",
    "bullmq": "5.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.1",
    "firebase-admin": "^10.3.0",
    "helmet": "^8.1.0",
    "ioredis": "5.4.1",
    "mongoose": "^8.3.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "uuid": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/pdf-parse": "^1.1.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "bullmq": {
      "ioredis": "5.4.1"
    }
  }
}
