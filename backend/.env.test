# ─── ScholarAI Environment Variables ────────────────────────────────────────────────
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/database

# ─── AI API Keys ─────────────────────────────────────────────────────────────
GEMINI_EMBEDDING_API_KEY=YOUR_GEMINI_EMBEDDING_KEY
GEMINI_ANALYSIS_API_KEY=YOUR_GEMINI_ANALYSIS_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
HF_TOKEN=YOUR_HUGGINGFACE_TOKEN

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URI=redis://localhost:6379


# ─── Backend Server ────────────────────────────────────────────────────────────
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3033,http://127.0.0.1:3033,https://your-hosted-app.com
ENV=dev
HOST=0.0.0.0
PORT=2022

# ─── ML Service ────────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=YOUR_ML_SERVICE_API_KEY

# ─── Subscription ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3033
ADMIN_EMAIL=admin@example.com

# ─── ML Ingestion & Search Config ───────────────────────────────────────────
ENABLE_REMOTE_EMBEDDINGS=False
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
VECTOR_INDEX_NAME=vector_index
VECTOR_NUM_CANDIDATES=200
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
DATABASE_NAME=scholarai
